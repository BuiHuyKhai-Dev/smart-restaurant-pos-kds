# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env lên Git.

# Supabase - Transaction Pooler (cổng 6543) cho ứng dụng. Bắt buộc có ?pgbouncer=true
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase - Session Pooler (cổng 5432) cho Prisma Migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

PORT=4000

# Secret ký JWT cho nhân viên (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Secret ký mã QR bàn ăn (khác JWT_SECRET)
TABLE_QR_SECRET="change-me-to-another-long-random-string"

# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGIN="http://localhost:3000"
# Dùng để sinh URL trong mã QR bàn
FRONTEND_URL="http://localhost:3000"

