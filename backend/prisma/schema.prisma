datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Model test kết nối ban đầu
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("WAITER")
  createdAt DateTime @default(now())
}